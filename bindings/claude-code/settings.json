{
  "_comment": "Merge into .claude/settings.json (project) or ~/.claude/settings.json (global). Upstream `bd setup claude` installs SessionStart+PreCompact running `bd prime`; this adds sync, gate check, and in_progress report. Verify the `Stop` hook name against your Claude Code version.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bd sync --json >/dev/null 2>&1; bd prime" },
          { "type": "command", "command": "bd gate check 2>/dev/null || true" },
          { "type": "command", "command": "bd list --status in_progress --json 2>/dev/null || true" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bd prime" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bd sync --json >/dev/null 2>&1 || true" }
        ]
      }
    ]
  }
}
